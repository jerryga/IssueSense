@model IssueSense.Web.Models.Auth.LoginViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment

@{
    ViewData["Title"] = "Login";
    var showDemoAccounts = !WebHostEnvironment.IsProduction();
}

<div class="mx-auto mt-10 @(showDemoAccounts ? "grid max-w-5xl gap-8 lg:grid-cols-[1.15fr_0.85fr]" : "max-w-2xl")">
    <section class="rounded-[2rem] border border-white/60 bg-white/90 p-8 shadow-soft backdrop-blur">
        <div class="mb-8">
            <span class="inline-flex rounded-full border border-accent-200 bg-accent-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-accent-700">Operational Access</span>
            <h1 class="mt-4 text-3xl font-semibold tracking-tight text-slatebrand-900">Sign in to the complaint intelligence workspace</h1>
            <p class="mt-3 max-w-2xl text-sm leading-6 text-slatebrand-600">Use one of the configured roles to review complaint trends, manage case workflows, and audit AI-generated guidance.</p>
        </div>

        <form asp-action="Login" method="post" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>

            <div>
                <label asp-for="UserName" class="mb-2 block text-sm font-medium text-slatebrand-800"></label>
                <input asp-for="UserName" class="w-full rounded-2xl border border-slatebrand-200 bg-white px-4 py-3 text-slatebrand-900 shadow-sm outline-none transition focus:border-accent-500 focus:ring-4 focus:ring-accent-100" />
                <span asp-validation-for="UserName" class="mt-2 block text-sm text-red-600"></span>
            </div>

            <div>
                <label asp-for="Password" class="mb-2 block text-sm font-medium text-slatebrand-800"></label>
                <input asp-for="Password" class="w-full rounded-2xl border border-slatebrand-200 bg-white px-4 py-3 text-slatebrand-900 shadow-sm outline-none transition focus:border-accent-500 focus:ring-4 focus:ring-accent-100" />
                <span asp-validation-for="Password" class="mt-2 block text-sm text-red-600"></span>
            </div>

            <button type="submit" class="inline-flex w-full items-center justify-center rounded-2xl bg-accent-500 px-4 py-3 text-sm font-semibold text-white shadow-lg shadow-accent-500/20 transition hover:bg-accent-600">Login</button>
        </form>
    </section>

    @if (showDemoAccounts)
    {
        <aside class="overflow-hidden rounded-[2rem] border border-slatebrand-200 bg-slatebrand-900 text-slatebrand-50 shadow-soft">
            <div class="border-b border-white/10 px-8 py-6">
                <h2 class="text-lg font-semibold tracking-tight">Demo Role Accounts</h2>
                <p class="mt-2 text-sm leading-6 text-slatebrand-200">Each role opens a different slice of the workflow so you can validate RBAC and the complaint lifecycle end to end.</p>
            </div>
            <div class="space-y-4 px-8 py-6 text-sm">
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                    <div class="font-semibold text-white">User Admin</div>
                    <div class="mt-1 text-slatebrand-200">useradmin / User@123</div>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                    <div class="font-semibold text-white">Support Admin</div>
                    <div class="mt-1 text-slatebrand-200">admin / Admin@123</div>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                    <div class="font-semibold text-white">Analyst</div>
                    <div class="mt-1 text-slatebrand-200">analyst / Analyst@123</div>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                    <div class="font-semibold text-white">Triage Officer</div>
                    <div class="mt-1 text-slatebrand-200">triage / Triage@123</div>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                    <div class="font-semibold text-white">Case Manager</div>
                    <div class="mt-1 text-slatebrand-200">casemanager / Case@123</div>
                </div>
                <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                    <div class="font-semibold text-white">AI Reviewer</div>
                    <div class="mt-1 text-slatebrand-200">aireviewer / Review@123</div>
                </div>
            </div>
        </aside>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
