@using IssueSense.Domain.Common
@using IssueSense.Web.Extensions
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IssueSense</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        slatebrand: {
                            50: "#f4f7fb",
                            100: "#e7eef6",
                            200: "#cddce9",
                            300: "#a8c0d7",
                            400: "#7d9fc0",
                            500: "#5b82a8",
                            600: "#45698d",
                            700: "#35516e",
                            800: "#25394f",
                            900: "#16263a"
                        },
                        accent: {
                            500: "#0b6e99",
                            600: "#095777",
                            700: "#08465f"
                        }
                    },
                    boxShadow: {
                        soft: "0 20px 60px rgba(22, 38, 58, 0.12)"
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-slatebrand-50 text-slatebrand-900 antialiased">
    <header class="border-b border-white/10 bg-gradient-to-r from-slatebrand-900 via-slatebrand-800 to-accent-600 text-white shadow-soft">
        <nav class="mx-auto flex max-w-7xl flex-col gap-4 px-4 py-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
            <div class="flex items-center justify-between gap-4">
                <a asp-controller="Dashboard" asp-action="Index" class="text-xl font-semibold tracking-tight">IssueSense</a>
            </div>
            <div class="flex flex-col gap-4 lg:flex-1 lg:flex-row lg:items-center lg:justify-between">
                <ul class="flex flex-wrap items-center gap-2 text-sm font-medium text-slatebrand-100 lg:ml-8">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li>
                            <a asp-controller="Dashboard" asp-action="Index" class="rounded-full px-4 py-2 transition hover:bg-white/10 hover:text-white">Dashboard</a>
                        </li>
                        <li>
                            <a asp-controller="Complaint" asp-action="Index" class="rounded-full px-4 py-2 transition hover:bg-white/10 hover:text-white">Complaints</a>
                        </li>
                        @if (User.IsInRole(RoleNames.UserAdmin))
                        {
                            <li>
                                <a asp-controller="Users" asp-action="Index" class="rounded-full px-4 py-2 transition hover:bg-white/10 hover:text-white">Users</a>
                            </li>
                        }
                        @if (User.IsInRole(RoleNames.SupportAdmin) || User.IsInRole(RoleNames.TriageOfficer) || User.IsInRole(RoleNames.CaseManager))
                        {
                            <li>
                                <a asp-controller="Complaint" asp-action="Create" class="rounded-full px-4 py-2 transition hover:bg-white/10 hover:text-white">Create</a>
                            </li>
                        }
                    }
                </ul>
                <div class="flex flex-col gap-3 text-sm text-slatebrand-100 sm:flex-row sm:items-center sm:justify-end">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="rounded-full border border-white/15 bg-white/5 px-4 py-2">@User.Identity.Name (@User.GetRoleDisplayName())</span>
                        <form asp-controller="Auth" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="inline-flex items-center justify-center rounded-full border border-white/20 px-4 py-2 font-medium text-white transition hover:bg-white/10">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" class="inline-flex items-center justify-center rounded-full border border-white/20 px-4 py-2 font-medium text-white transition hover:bg-white/10">Login</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
        @RenderBody()
    </main>

    <div id="ai-loading-overlay" class="pointer-events-none fixed inset-0 z-50 hidden items-center justify-center bg-slatebrand-900/40 px-4 backdrop-blur-sm">
        <div class="w-full max-w-md rounded-[1.75rem] border border-white/70 bg-white/95 p-6 text-center shadow-soft">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-accent-50">
                <div class="h-7 w-7 animate-spin rounded-full border-[3px] border-accent-200 border-t-accent-600"></div>
            </div>
            <h2 id="ai-loading-title" class="mt-5 text-xl font-semibold tracking-tight text-slatebrand-900">Analyzing Complaint</h2>
            <p id="ai-loading-message" class="mt-3 text-sm leading-6 text-slatebrand-600">The AI model is reviewing the complaint and generating sentiment, urgency, and action guidance.</p>
        </div>
    </div>

    <div id="ai-loading-toast" class="pointer-events-none fixed right-4 top-4 z-50 hidden max-w-sm rounded-2xl border border-accent-200 bg-white/95 px-4 py-4 shadow-soft ring-1 ring-accent-100 backdrop-blur">
        <div class="flex items-start gap-3">
            <div class="mt-0.5 flex h-9 w-9 items-center justify-center rounded-full bg-accent-50">
                <div class="h-4 w-4 animate-spin rounded-full border-2 border-accent-200 border-t-accent-600"></div>
            </div>
            <div>
                <p id="ai-loading-toast-title" class="text-sm font-semibold text-slatebrand-900">AI analysis in progress</p>
                <p id="ai-loading-toast-message" class="mt-1 text-sm leading-6 text-slatebrand-600">Please wait while the system processes the complaint.</p>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
