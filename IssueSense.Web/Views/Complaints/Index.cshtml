@model IssueSense.Web.Models.Complaints.ComplaintIndexPageViewModel
@using IssueSense.Domain.Common

@{
    ViewData["Title"] = "Complaints";

    static string BadgeClass(string value) => value.ToLowerInvariant() switch
    {
        "archived" => "bg-slate-200 text-slate-700 ring-slate-300",
        "new" => "bg-blue-100 text-blue-700 ring-blue-200",
        "inprogress" => "bg-amber-100 text-amber-700 ring-amber-200",
        "resolved" => "bg-emerald-100 text-emerald-700 ring-emerald-200",
        "closed" => "bg-slate-200 text-slate-700 ring-slate-300",
        "escalated" => "bg-rose-100 text-rose-700 ring-rose-200",
        "normal" => "bg-emerald-100 text-emerald-700 ring-emerald-200",
        "negative" => "bg-rose-100 text-rose-700 ring-rose-200",
        "neutral" => "bg-slate-100 text-slate-700 ring-slate-200",
        "positive" => "bg-emerald-100 text-emerald-700 ring-emerald-200",
        "high" => "bg-rose-100 text-rose-700 ring-rose-200",
        "medium" => "bg-amber-100 text-amber-700 ring-amber-200",
        "low" => "bg-sky-100 text-sky-700 ring-sky-200",
        _ => "bg-slate-100 text-slate-700 ring-slate-200"
    };
}

<div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h1 class="text-3xl font-semibold tracking-tight text-slatebrand-900">Complaints</h1>
        <p class="mt-2 text-sm text-slatebrand-600">Track status, sentiment, category, urgency, escalation, and assignment in one place.</p>
    </div>
    @if (User.IsInRole(RoleNames.SupportAdmin) || User.IsInRole(RoleNames.TriageOfficer) || User.IsInRole(RoleNames.CaseManager))
    {
        <a asp-action="Create" class="inline-flex items-center justify-center rounded-2xl bg-accent-500 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-accent-500/20 transition hover:bg-accent-600">Create Complaint</a>
    }
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="mb-6 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700">@successMessage</div>
}

<section class="rounded-[2rem] border border-white/60 bg-white/90 p-6 shadow-soft backdrop-blur">
    <form method="get" class="grid gap-4 lg:grid-cols-12">
        <div class="lg:col-span-4">
            <label class="mb-2 block text-sm font-medium text-slatebrand-800">Search</label>
            <input asp-for="Query.SearchTerm" class="w-full rounded-2xl border border-slatebrand-200 bg-white px-4 py-3 text-slatebrand-900 outline-none transition focus:border-accent-500 focus:ring-4 focus:ring-accent-100" placeholder="Title, customer, email, category" />
        </div>
        <div class="md:col-span-6 lg:col-span-2">
            <label class="mb-2 block text-sm font-medium text-slatebrand-800">Status</label>
            <select asp-for="Query.Status" class="w-full rounded-2xl border border-slatebrand-200 bg-white px-4 py-3 text-slatebrand-900 outline-none transition focus:border-accent-500 focus:ring-4 focus:ring-accent-100" asp-items="Html.GetEnumSelectList<IssueSense.Domain.Enums.ComplaintStatus>()">
                <option value="">All</option>
            </select>
        </div>
        <div class="md:col-span-6 lg:col-span-2">
            <label class="mb-2 block text-sm font-medium text-slatebrand-800">Sentiment</label>
            <select asp-for="Query.Sentiment" class="w-full rounded-2xl border border-slatebrand-200 bg-white px-4 py-3 text-slatebrand-900 outline-none transition focus:border-accent-500 focus:ring-4 focus:ring-accent-100" asp-items="Html.GetEnumSelectList<IssueSense.Domain.Enums.SentimentType>()">
                <option value="">All</option>
            </select>
        </div>
        <div class="md:col-span-6 lg:col-span-2">
            <label class="mb-2 block text-sm font-medium text-slatebrand-800">Urgency</label>
            <select asp-for="Query.Urgency" class="w-full rounded-2xl border border-slatebrand-200 bg-white px-4 py-3 text-slatebrand-900 outline-none transition focus:border-accent-500 focus:ring-4 focus:ring-accent-100" asp-items="Html.GetEnumSelectList<IssueSense.Domain.Enums.UrgencyLevel>()">
                <option value="">All</option>
            </select>
        </div>
        <div class="md:col-span-6 lg:col-span-2">
            <label class="mb-2 block text-sm font-medium text-slatebrand-800">Escalation</label>
            <select asp-for="Query.EscalationStatus" class="w-full rounded-2xl border border-slatebrand-200 bg-white px-4 py-3 text-slatebrand-900 outline-none transition focus:border-accent-500 focus:ring-4 focus:ring-accent-100" asp-items="Html.GetEnumSelectList<IssueSense.Domain.Enums.EscalationStatus>()">
                <option value="">All</option>
            </select>
        </div>
        <div class="flex flex-wrap items-center gap-3 pt-2 lg:col-span-12">
            <button type="submit" class="inline-flex items-center justify-center rounded-2xl bg-accent-500 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-accent-500/20 transition hover:bg-accent-600">Apply Filters</button>
            <a asp-action="Index" class="inline-flex items-center justify-center rounded-2xl border border-slatebrand-200 bg-white px-5 py-3 text-sm font-semibold text-slatebrand-700 transition hover:border-slatebrand-300 hover:bg-slatebrand-50">Clear</a>
            @if (User.IsInRole(RoleNames.SupportAdmin))
            {
                <label class="ml-1 inline-flex items-center gap-2 text-sm text-slatebrand-600">
                    <input asp-for="Query.IncludeArchived" type="checkbox" class="h-4 w-4 rounded border-slatebrand-300 text-accent-500 focus:ring-accent-200" />
                    <span>Include archived</span>
                </label>
            }
            <span class="text-sm text-slatebrand-500">Showing @Model.Complaints.Count complaint(s)</span>
        </div>
    </form>

    @if (!Model.Complaints.Any())
    {
        <div class="mt-8 rounded-2xl border border-dashed border-slatebrand-200 bg-slatebrand-50 px-6 py-10 text-center text-sm text-slatebrand-500">No complaints found.</div>
    }
    else
    {
        <div class="mt-8 overflow-hidden rounded-[1.5rem] border border-slatebrand-200">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slatebrand-200 text-sm">
                    <thead class="bg-slatebrand-100/70 text-left text-xs font-semibold uppercase tracking-[0.14em] text-slatebrand-600">
                        <tr>
                            <th class="px-5 py-4">Title</th>
                            <th class="px-5 py-4">Customer</th>
                            <th class="px-5 py-4">Category</th>
                            <th class="px-5 py-4">Status</th>
                            <th class="px-5 py-4">Sentiment</th>
                            <th class="px-5 py-4">Urgency</th>
                            <th class="px-5 py-4">Escalation</th>
                            <th class="px-5 py-4">Assigned To</th>
                            <th class="px-5 py-4">Confidence</th>
                            <th class="px-5 py-4">Created</th>
                            <th class="px-5 py-4 text-right"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slatebrand-100 bg-white">
                    @foreach (var complaint in Model.Complaints)
                    {
                        <tr class="align-top">
                            <td class="px-5 py-4">
                                <div class="font-semibold text-slatebrand-900">@complaint.Title</div>
                                <div class="mt-1 text-xs text-slatebrand-500">@complaint.CustomerName</div>
                            </td>
                            <td class="px-5 py-4 text-slatebrand-700">@complaint.CustomerName</td>
                            <td class="px-5 py-4 text-slatebrand-700">@complaint.Category</td>
                            <td class="px-5 py-4"><span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset @BadgeClass(complaint.Status.ToString())">@complaint.Status</span></td>
                            <td class="px-5 py-4"><span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset @BadgeClass(complaint.Sentiment.ToString())">@complaint.Sentiment</span></td>
                            <td class="px-5 py-4"><span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset @BadgeClass(complaint.Urgency.ToString())">@complaint.Urgency</span></td>
                            <td class="px-5 py-4"><span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset @BadgeClass(complaint.EscalationStatus.ToString())">@complaint.EscalationStatus</span></td>
                            <td class="px-5 py-4 text-slatebrand-700">@(string.IsNullOrWhiteSpace(complaint.AssignedOwner) ? "-" : complaint.AssignedOwner)</td>
                            <td class="px-5 py-4 text-slatebrand-700">@($"{complaint.Confidence:P0}")</td>
                            <td class="px-5 py-4 text-slatebrand-700">@complaint.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                            <td class="px-5 py-4 text-right">
                                @if (complaint.IsArchived)
                                {
                                    <span class="mr-2 inline-flex rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset @BadgeClass("archived")">Archived</span>
                                }
                                <a asp-action="Details" asp-route-id="@complaint.Id" class="inline-flex items-center justify-center rounded-full border border-slatebrand-200 px-4 py-2 text-xs font-semibold text-slatebrand-700 transition hover:border-accent-200 hover:bg-accent-50 hover:text-accent-700">Details</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>
